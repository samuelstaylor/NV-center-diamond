&CONTROL
calculation = 'scf'
restart_mode = 'from_scratch'
prefix = 'pwscf'
!pseudo_dir = '/home/jinyuchem/program/QE/pseudo-potential'
outdir = './'
wf_collect = .TRUE.
!tstress = .TRUE.
tprnfor = .TRUE.
verbosity = 'high'
/
&SYSTEM
